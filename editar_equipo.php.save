<?php
include("verificar_sesion.php");
include("conexion.php");

if (!isset($_GET["id"])) {
    die("ID no proporcionado.");
}

$id = $_GET["id"];
$mensaje = "";

$sql = "SELECT * FROM equipos WHERE id = '$id'";
$resultado = $conn->query($sql);

if (!$resultado || $resultado->num_rows == 0) {
    die("Equipo no encontrado.");
}

$equipo = $resultado->fetch_assoc();

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $nombre = $_POST["nombre"];
    $ip = $_POST["ip"];
    $ubicacion = $_POST["ubicacion"];
    $tipo = $_POST["tipo"];
    $sistema_operativo = $_POST["sistema_operativo"];
    $descripcion = $_POST["descripcion"];
    $metricas_habilitadas = isset($_POST["metricas_habilitadas"]) ? 1 : 0;
    $instancia_metricas = trim($_POST["instancia_metricas"]);

    $update = "UPDATE equipos 
               SET nombre='$nombre',
                   ip='$ip',
                   ubicacion='$ubicacion',
                   tipo='$tipo',
                   sistema_operativo='$sistema_operativo',
                   descripcion='$descripcion'
                   metricas_habilitadas='$metricas_habilitadas',
                   instancia_metricas='$instancia_metricas' 
               WHERE id='$id'";

    if ($conn->query($update) === TRUE) {
        $mensaje = "Equipo actualizado correctamente.";

        $sql = "SELECT * FROM equipos WHERE id = '$id'";
        $resultado = $conn->query($sql);
        $equipo = $resultado->fetch_assoc();
    } else {
        $mensaje = "Error: " . $conn->error;
    }
}

include("header.php");
?>

