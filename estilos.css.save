* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background: linear-gradient(135deg, #0b1220, #111827, #1e293b);
    color: #f8fafc;
    min-height: 100vh;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

header {
    padding: 24px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(8px);
}

.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

.brand {
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand svg {
    width: 54px;
    height: 54px;
}

.brand-text h1 {
    font-size: 1.5rem;
    color: #ffffff;
}

.brand-text p {
    font-size: 0.9rem;
    color: #94a3b8;
}

.menu {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.menu a {
    text-decoration: none;
    color: #e2e8f0;
    padding: 10px 16px;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    transition: 0.3s;
    border: 1px solid rgba(255,255,255,0.08);
}

.menu a:hover {
    background: #2563eb;
    color: white;
    transform: translateY(-2px);
}

main {
    padding: 40px 0 60px;
}

.page-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.25);
}

.page-title {
    font-size: 2rem;
    margin-bottom: 10px;
}

.page-subtitle {
    color: #cbd5e1;
    margin-bottom: 28px;
    line-height: 1.6;
}

form label {
    display: block;
    margin-bottom: 8px;
    color: #e2e8f0;
    font-weight: bold;
}

form input,
form textarea,
form select {
    width: 100%;
    padding: 12px 14px;
    margin-bottom: 18px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.85);
    color: #ffffff;
    outline: none;
}

form textarea {
    min-height: 120px;
    resize: vertical;
}

.btn {
    display: inline-block;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 12px;
    font-weight: bold;
    transition: 0.3s;
    border: none;
    cursor: pointer;
}

.btn-primary {
    background: linear-gradient(90deg, #2563eb, #38bdf8);
    color: white;
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.35);
}

.btn-primary:hover {
    transform: translateY(-2px);
    opacity: 0.95;
}

.btn-secondary {
    background: rgba(255,255,255,0.06);
    color: #f8fafc;
    border: 1px solid rgba(255,255,255,0.1);
}

.btn-secondary:hover {
    background: rgba(255,255,255,0.12);
    transform: translateY(-2px);
}

.actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
    margin-bottom: 20px;
}

.message {
    margin-bottom: 18px;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(34,197,94,0.12);
    color: #86efac;
    border: 1px solid rgba(34,197,94,0.25);
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(15, 23, 42, 0.65);
    border-radius: 16px;
    overflow: hidden;
}

table th,
table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

table th {
    background: rgba(37,99,235,0.22);
    color: #ffffff;
}

table td {
    color: #e2e8f0;
}

.badge {
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: bold;
    display: inline-block;
}

.ok {
    background: rgba(34,197,94,0.18);
    color: #4ade80;
}

.down {
    background: rgba(239,68,68,0.15);
    color: #f87171;
}

.warn {
    background: rgba(250,204,21,0.15);
    color: #fde047;
}

footer {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 22px 0 40px;
    color: #94a3b8;
    text-align: center;
}

@media (max-width: 900px) {
    .menu {
        width: 100%;
    }

    .page-title {
        font-size: 1.6rem;
    }
}


.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    margin-bottom: 24px;
}

.stat-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 22px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.18);
}

.stat-card h3 {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 10px;
    font-weight: normal;
}

.stat-number {
    font-size: 2rem;
    font-weight: bold;
    color: #ffffff;
}

.section-space {
    margin-bottom: 28px;
}

.soft-box {
    background: rgba(255,255,255,0.04);
    border-radius: 16px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,0.06);
}

.muted {
    color: #94a3b8;
}

.status-text-active {
    color: #4ade80;
    font-weight: bold;
}

.status-text-inactive {
    color: #f87171;
    font-weight: bold;
}

.table-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.page-note {
    color: #cbd5e1;
    line-height: 1.6;
}

.highlight-value {
    color: #38bdf8;
    font-weight: bold;
}

.form-layout {
    display: grid;
    grid-template-columns: 1.5fr 0.9fr;
    gap: 22px;
    align-items: start;
}

.info-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 22px;
}

.info-card h3 {
    margin-bottom: 12px;
    color: #ffffff;
}

.info-card p {
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: 14px;
}

.info-card ul {
    padding-left: 20px;
    color: #cbd5e1;
    line-height: 1.9;
}

.form-section-title {
    font-size: 1.1rem;
    margin-bottom: 14px;
    color: #ffffff;
}

.form-divider {
    height: 1px;
    background: rgba(255,255,255,0.08);
    margin: 18px 0 22px;
}

@media (max-width: 900px) {
    .form-layout {
        grid-template-columns: 1fr;
    }
}

.action-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.btn-sm {
    padding: 8px 12px;
    font-size: 0.85rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
}

.btn-edit {
    background: rgba(56, 189, 248, 0.18);
    color: #7dd3fc;
    border: 1px solid rgba(56, 189, 248, 0.28);
}

.btn-edit:hover {
    background: rgba(56, 189, 248, 0.28);
}

.btn-delete {
    background: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.25);
}

.btn-delete:hover {
    background: rgba(239, 68, 68, 0.24);
}

