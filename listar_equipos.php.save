    <div class="table-wrapper">
        <table>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>IP</th>
                <th>Ubicación</th>
                <th>Tipo</th>
                <th>Sistema Operativo</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>

            <?php
            if ($resultado && $resultado->num_rows > 0) {
                while ($fila = $resultado->fetch_assoc()) {
                    echo "<tr>";
                    echo "<td>" . $fila["id"] . "</td>";
                    echo "<td><span class='highlight-value'>" . htmlspecialchars($fila["nombre"]) . "</span></td>";
                    echo "<td>" . htmlspecialchars($fila["ip"]) . "</td>";
                    echo "<td>" . htmlspecialchars($fila["ubicacion"]) . "</td>";
                    echo "<td>" . htmlspecialchars($fila["tipo"]) . "</td>";
                    echo "<td>" . htmlspecialchars($fila["sistema_operativo"]) . "</td>";
                    echo "<td>" . htmlspecialchars($fila["descripcion"]) . "</td>";
                    echo "<td>
                            <div class='action-buttons'>
                                <a class='btn-sm btn-edit' href='editar_equipo.php?id=" . $fila["id"] . "'>Editar</a>
                                <a class='btn-sm btn-delete' href='eliminar_equipo.php?id=" . $fila["id"] . "' onclick=\"return confirm('¿Seguro que deseas eliminar este equipo?');\">Eliminar</a>
                            </div>
                          </td>";
                    echo "</tr>";
                }
            } else {
                echo "<tr><td colspan='8'>No se encontraron equipos</td></tr>";
            }
            ?>
